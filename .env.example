APP_NAME="Daria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Rome

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=commerciale_ai
# DB_USERNAME=commerciale_ai
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Predisposizione futura Resend. Per pilota e primi clienti lasciare
# MAIL_MAILER=smtp e queste variabili vuote/disattivate.
RESEND_API_KEY=
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_SCHEME=smtps
RESEND_SMTP_USERNAME=resend
RESEND_SMTP_TIMEOUT=30
RESEND_API_URL=https://api.resend.com
RESEND_DOMAIN_AUTOMATION_ENABLED=false

# Collegamento firmato con il plugin WordPress. Generare almeno 32 byte casuali.
BILLING_SELF_SERVICE_ENABLED=false
BILLING_INTEGRATION_KEY=
# Lasciare false durante il pilota; abilitarlo solo dopo avere assegnato le licenze.
LICENSE_ENFORCEMENT_ENABLED=false

# Le caselle e le credenziali IMAP si configurano dal pannello web.
IMAP_TIMEOUT=30
IMAP_SYNC_SINCE_DAYS=14
IMAP_MAX_MESSAGES=50
AUTOMATION_EXTERNAL_SEND_ENABLED=false

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT=45
OPENAI_INPUT_COST_PER_MILLION=2.5
OPENAI_OUTPUT_COST_PER_MILLION=15
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
